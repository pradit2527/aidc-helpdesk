    "@types/react-dom": "19.0.3",
    "tailwindcss": "3.4.17",
    "postcss": "8.5.1",
    "autoprefixer": "10.4.20",
    "prettier": "3.4.2",
    "prettier-plugin-tailwindcss": "0.6.10",
    "eslint": "9.18.0",
    "eslint-config-next": "15.1.6",
    "openapi-typescript": "7.5.2",
    "msw": "2.7.0",
