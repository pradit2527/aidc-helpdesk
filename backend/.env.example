# ============================================================================
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้ตรงกับเครื่องตัวเอง (.env ถูก git ignore)
# ============================================================================

NODE_ENV=development
PORT=8000
TZ=Asia/Vientiane

# ----------------------------------------------------------------------------
# ฐานข้อมูล
#
# DATABASE_URL  = บัญชีที่ตัวแอปใช้ตอนรัน ไม่มีสิทธิ์ DDL
# MIGRATE_URL   = บัญชีเจ้าของ schema ใช้เฉพาะตอน db:migrate
#                 ต้องเป็น superuser เพราะ 0001 เรียก CREATE EXTENSION
#
# รหัสผ่านที่มีอักขระพิเศษต้อง percent-encode ในสตริง URL
# เช่น @ ต้องเขียนเป็น %40 มิฉะนั้นจะถูกอ่านเป็นตัวคั่น host
# ----------------------------------------------------------------------------
DATABASE_URL=postgresql://aidc_app:aidc_app_dev_2026@localhost:5432/aidc_helpdesk
MIGRATE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/aidc_helpdesk

# ----------------------------------------------------------------------------
# Redis — คิวงานแจ้งเตือนและงานยกระดับ SLA
# ----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ----------------------------------------------------------------------------
# ความปลอดภัย
#
# JWT_SECRET ต้องยาวอย่างน้อย 32 ไบต์ สร้างด้วย
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ----------------------------------------------------------------------------
JWT_SECRET=CHANGE_ME_ใช้คำสั่งด้านบนสร้างค่าใหม่
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_DOMAIN=localhost
# ตั้ง true เฉพาะตอนเสิร์ฟผ่าน https
COOKIE_SECURE=false

# ----------------------------------------------------------------------------
# ที่อยู่ frontend สำหรับ CORS — ต้องระบุตรง ๆ ห้ามใช้ *
# เพราะ auth ใช้คุกกี้ ต้องส่ง credentials ข้าม origin
# ----------------------------------------------------------------------------
FRONTEND_ORIGIN=http://localhost:3000

# ----------------------------------------------------------------------------
# ไฟล์แนบ
# ----------------------------------------------------------------------------
UPLOAD_DIR=./var/uploads
MAX_UPLOAD_BYTES=20971520

# โฟลเดอร์เก็บไฟล์แนบ — บน production ต้องชี้ไปดิสก์ที่สำรองข้อมูล
# มิฉะนั้นไฟล์หายพร้อมคอนเทนเนอร์ที่ถูกสร้างใหม่
ATTACHMENT_DIR=storage/attachments

# เปิดตัวจับเวลาในโปรเซสเมื่อ Redis ใช้ไม่ได้
# ⚠️ ใช้ได้เมื่อรันอินสแตนซ์เดียวเท่านั้น — หลายเครื่องจะกวาดซ้ำและแจ้งเตือนซ้ำ
SLA_SCAN_FALLBACK=false

# ----------------------------------------------------------------------------
# Super Work — ส่งเรื่องแจ้งใหม่ขึ้นบอร์ด Partner Workboard
#
# ปิดไว้เป็นค่าเริ่มต้น เปิดเมื่อจะยิงของจริงขึ้นบอร์ดที่ทีมใช้งานอยู่เท่านั้น
# ค่า id ทั้งหมดหาได้จาก API เอง ไม่ต้องเดา:
#   GET /projects  →  GET /projects/{id}/activities  →  GET /activities/{id}
#
# SUPERWORK_POINT ปล่อยว่าง = ไม่ส่ง point/dueDate
#   สองค่านี้ต้องมาคู่กันเสมอ (400 point_deadline_pair_required) และจะถูก
#   ทิ้งเงียบ ๆ พร้อมตอบ 201 ถ้าพนักงานที่คีย์สวมบทบาทไม่ใช่หัวหน้า activity
#   กำหนดเวลา SLA ยังถูกเขียนไว้ในคำอธิบายของ task อยู่ดี
# ----------------------------------------------------------------------------
SUPERWORK_ENABLED=false
SUPERWORK_BASE_URL=https://endpoint.superwork.tech/api/v1/partner/workboard
SUPERWORK_API_KEY=
SUPERWORK_ACTIVITY_ID=
SUPERWORK_CARD_ID=
SUPERWORK_MEMBER_IDS=
SUPERWORK_CHECKER_IDS=
SUPERWORK_POINT=
SUPERWORK_TIMEOUT_MS=8000
