# ============================================================================
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้ตรงกับเครื่องตัวเอง (.env ถูก git ignore)
# ============================================================================

NODE_ENV=development
PORT=8000
TZ=Asia/Vientiane

# ----------------------------------------------------------------------------
# ฐานข้อมูล
#
# DATABASE_URL  = บัญชีที่ตัวแอปใช้ตอนรัน ไม่มีสิทธิ์ DDL
# MIGRATE_URL   = บัญชีเจ้าของ schema ใช้เฉพาะตอน db:migrate
#                 ต้องเป็น superuser เพราะ 0001 เรียก CREATE EXTENSION
#
# รหัสผ่านที่มีอักขระพิเศษต้อง percent-encode ในสตริง URL
# เช่น @ ต้องเขียนเป็น %40 มิฉะนั้นจะถูกอ่านเป็นตัวคั่น host
# ----------------------------------------------------------------------------
DATABASE_URL=postgresql://aidc_app:aidc_app_dev_2026@localhost:5432/aidc_helpdesk
MIGRATE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/aidc_helpdesk

# ----------------------------------------------------------------------------
# Redis — คิวงานแจ้งเตือนและงานยกระดับ SLA
# ----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ----------------------------------------------------------------------------
# ความปลอดภัย
#
# JWT_SECRET ต้องยาวอย่างน้อย 32 ไบต์ สร้างด้วย
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ----------------------------------------------------------------------------
JWT_SECRET=CHANGE_ME_ใช้คำสั่งด้านบนสร้างค่าใหม่
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_DOMAIN=localhost
# ตั้ง true เฉพาะตอนเสิร์ฟผ่าน https
COOKIE_SECURE=false

# ----------------------------------------------------------------------------
# ที่อยู่ frontend สำหรับ CORS — ต้องระบุตรง ๆ ห้ามใช้ *
# เพราะ auth ใช้คุกกี้ ต้องส่ง credentials ข้าม origin
# ----------------------------------------------------------------------------
FRONTEND_ORIGIN=http://localhost:3000

# ----------------------------------------------------------------------------
# ไฟล์แนบ
# ----------------------------------------------------------------------------
UPLOAD_DIR=./var/uploads
MAX_UPLOAD_BYTES=20971520
