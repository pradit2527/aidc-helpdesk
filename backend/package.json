{
  "name": "aidc-helpdesk-api",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "worker": "node dist/workers/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed/index.ts",
    "openapi:dump": "tsx src/tools/dump-openapi.ts",
    "test:e2e": "node test/run-all.mjs"
  },
  "dependencies": {
    "@date-fns/tz": "1.2.0",
    "@nestjs/common": "11.0.7",
    "@nestjs/config": "4.0.0",
    "@nestjs/core": "11.0.7",
    "@nestjs/platform-express": "11.0.7",
    "@nestjs/swagger": "11.0.3",
    "@nestjs/throttler": "6.4.0",
    "argon2": "0.41.1",
    "bullmq": "5.34.10",
    "class-transformer": "0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "1.4.7",
    "date-fns": "4.1.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "0.38.4",
    "exceljs": "4.4.0",
    "helmet": "8.0.0",
    "ioredis": "5.4.2",
    "jose": "5.9.6",
    "nestjs-pino": "4.3.0",
    "pino-http": "10.4.0",
    "postgres": "3.4.5",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.2",
    "@nestjs/testing": "11.0.7",
    "@types/cookie-parser": "1.4.8",
    "@types/express": "5.0.0",
    "@types/node": "22.10.7",
    "drizzle-kit": "0.30.2",
    "eslint": "9.18.0",
    "pino-pretty": "^13.1.3",
    "prettier": "3.4.2",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "3.0.4"
  }
}
